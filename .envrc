# --- Emscripten via emsdk (direnv) ---
export EMSDK_DIR="/home/dave/GitHub/emsdk"

# Load emsdk environment into this directory only
if [ -f "$EMSDK_DIR/emsdk_env.sh" ]; then
  export EMSDK_QUIET=1
  source "$EMSDK_DIR/emsdk_env.sh" >/dev/null 2>&1
else
  echo "direnv: emsdk_env.sh not found at: $EMSDK_DIR"
fi
